<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cambiar contraseña · Realidades Financieras</title>
  <%- include('partials-style') %>
</head>
<body>
  <div class="card">
    <a href="/dashboard" style="color: var(--muted); font-size: 13px; text-decoration:none; display:block; margin-bottom:16px;">&larr; Volver al dashboard</a>
    <div class="brand">
      <div class="brand-mark">RF</div>
      <div class="brand-name">Realidades Financieras<small>Mi cuenta</small></div>
    </div>
    <h1>Cambiar mi contraseña</h1>
    <p class="subtitle">Tu verificación en dos pasos no cambia; solo se actualiza tu contraseña.</p>

    <form method="POST" action="/account/password">
      <label for="currentPassword">Contraseña actual</label>
      <input type="password" id="currentPassword" name="currentPassword" required autofocus />

      <label for="newPassword">Nueva contraseña</label>
      <input type="password" id="newPassword" name="newPassword" required minlength="8" placeholder="Mínimo 8 caracteres" />

      <label for="confirmPassword">Confirma la nueva contraseña</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" />

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="credentials-box" style="margin-top:16px;">Tu contraseña se actualizó correctamente.</div>
      <% } %>

      <button type="submit">Actualizar contraseña</button>
    </form>
  </div>
  <style>
    .credentials-box {
      background: rgba(47,209,150,0.08);
      border: 1px solid rgba(47,209,150,0.3);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--accent);
    }
  </style>
</body>
</html>
