<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar sesión · Realidades Financieras</title>
  <%- include('partials-style') %>
</head>
<body>
  <div class="card">
    <div class="brand">
      <div class="brand-mark">RF</div>
      <div class="brand-name">Realidades Financieras<small>Sistema de control industrial</small></div>
    </div>
    <h1>Acceso al sistema</h1>
    <p class="subtitle">Ingresa tu usuario y contraseña. Después se te pedirá un código de verificación en dos pasos.</p>

    <form method="POST" action="/login">
      <label for="email">Usuario</label>
      <input type="email" id="email" name="email" required autofocus placeholder="usuario@realidadesfinancieras.com" />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required placeholder="••••••••" />

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <button type="submit">Continuar</button>
    </form>

    <a class="link-muted" href="/setup-2fa">Configurar apps de verificación (antes de la demo)</a>

    <div class="demo-note">
      <strong>Usuarios de prueba</strong> (contraseña entre paréntesis):<br/>
      <% users.forEach(function(u) { %>
        <%= u.email %> (<%= u.password %>)<br/>
      <% }); %>
    </div>

    <div class="stripe-footer"></div>
  </div>
</body>
</html>
