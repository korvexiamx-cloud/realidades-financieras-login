<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

  :root {
    --bg-1: #12151a;
    --bg-2: #1a1e26;
    --plate: #1e232c;
    --plate-2: #242a34;
    --border: #333b47;
    --border-strong: #454f5e;
    --text: #eef1f5;
    --muted: #8b96a5;
    --accent: #f5a623;
    --accent-dark: #cc8712;
    --accent-contrast: #1a1300;
    --danger: #ff5c5c;
    --ok: #3fd17d;
    --safety-stripe: repeating-linear-gradient(
      135deg,
      var(--accent) 0 14px,
      #1a1a1a 14px 28px
    );
  }

  * { box-sizing: border-box; }

  html, body {
    height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 20% 0%, rgba(245,166,35,0.06), transparent 45%),
      linear-gradient(180deg, var(--bg-1), var(--bg-2));
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    padding: 32px 20px;
    position: relative;
  }

  /* franja de "advertencia" superior, referencia visual industrial */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: var(--safety-stripe);
    opacity: 0.9;
  }

  .card {
    width: 100%;
    max-width: 400px;
    background: var(--plate);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 38px 34px;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.03) inset,
      0 30px 70px rgba(0,0,0,0.55);
    position: relative;
  }

  /* remaches en las esquinas */
  .card::before, .card::after {
    content: '';
    position: absolute;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #6b7280, #23272f);
    top: 10px;
  }
  .card::before { left: 10px; }
  .card::after { right: 10px; }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
  }
  .brand-mark {
    width: 42px; height: 42px;
    border-radius: 3px;
    background: var(--plate-2);
    border: 1px solid var(--border-strong);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-weight: 700; color: var(--accent); font-size: 16px;
    letter-spacing: 0.5px;
    position: relative;
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(245,166,35,0.35);
    border-radius: 2px;
  }
  .brand-name {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .brand-name small {
    display: block;
    color: var(--muted);
    font-weight: 400;
    font-size: 10.5px;
    text-transform: none;
    letter-spacing: 0.2px;
    margin-top: 2px;
    font-family: 'Inter', sans-serif;
  }

  h1 {
    font-family: 'Oswald', sans-serif;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.3px;
    margin: 0 0 6px;
    text-transform: uppercase;
  }
  p.subtitle {
    color: var(--muted);
    font-size: 13.5px;
    margin: 0 0 24px;
    line-height: 1.55;
  }

  label {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 7px;
    margin-top: 18px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 600;
  }

  input[type=email], input[type=password], input[type=text] {
    width: 100%;
    padding: 12px 13px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
    font-family: 'Inter', sans-serif;
  }
  input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(245,166,35,0.15);
  }
  input.otp-input {
    letter-spacing: 10px;
    font-size: 22px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    color: var(--accent);
  }

  button {
    width: 100%;
    margin-top: 26px;
    padding: 13px;
    background: var(--accent);
    color: var(--accent-contrast);
    border: none;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    cursor: pointer;
    transition: background .15s, transform .05s;
    font-family: 'Inter', sans-serif;
  }
  button:hover { background: var(--accent-dark); }
  button:active { transform: translateY(1px); }
  button.secondary {
    background: var(--plate-2);
    color: var(--text);
    border: 1px solid var(--border-strong);
  }
  button.secondary:hover { background: var(--border); }

  .error {
    background: rgba(255,92,92,0.08);
    border: 1px solid rgba(255,92,92,0.35);
    border-left: 3px solid var(--danger);
    color: var(--danger);
    padding: 10px 12px;
    border-radius: 3px;
    font-size: 13px;
    margin-top: 16px;
  }

  .hint { color: var(--muted); font-size: 12px; margin-top: 20px; line-height: 1.6; text-align: center; }

  .qr-wrap {
    background: #fff;
    padding: 14px;
    border-radius: 4px;
    display: flex;
    justify-content: center;
    margin: 20px 0;
    border: 1px solid var(--border-strong);
  }
  .qr-wrap img { width: 180px; height: 180px; display: block; }

  .secret-box {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 11px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--accent);
    word-break: break-all;
    text-align: center;
    margin-bottom: 4px;
    letter-spacing: 1px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(63,209,125,0.1);
    color: var(--ok);
    border: 1px solid rgba(63,209,125,0.3);
    padding: 4px 10px;
    border-radius: 2px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .6px;
    text-transform: uppercase;
  }
  .badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 6px var(--ok);
  }

  .demo-note {
    margin-top: 24px;
    padding: 12px 13px;
    border-radius: 3px;
    background: var(--bg-1);
    border: 1px dashed var(--border-strong);
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.6;
  }
  .demo-note strong { color: var(--text); }

  .user-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .user-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 3px;
  }
  .user-list .u-email {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text);
  }
  .user-list .u-role {
    font-size: 10px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: .5px;
    font-weight: 700;
  }
  .user-list a {
    font-size: 11.5px;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    padding: 6px 10px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .user-list a:hover { border-color: var(--accent); color: var(--accent); }

  .stripe-footer {
    height: 4px;
    margin: 28px -34px -38px;
    background: var(--safety-stripe);
    opacity: 0.85;
    border-radius: 0 0 3px 3px;
  }

  a.link-muted {
    display: block;
    text-align: center;
    margin-top: 10px;
    color: var(--muted);
    font-size: 12.5px;
    text-decoration: none;
  }
  a.link-muted:hover { color: var(--accent); }
</style>
