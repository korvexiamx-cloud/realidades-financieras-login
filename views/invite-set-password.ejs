<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Crea tu contraseña · Realidades Financieras</title>
  <%- include('partials-style') %>
</head>
<body>
  <div class="card">
    <div class="brand">
      <div class="brand-mark">RF</div>
      <div class="brand-name">Realidades Financieras<small>Sistema de contabilidad</small></div>
    </div>
    <span class="badge">Invitación</span>
    <h1 style="margin-top:12px;">Crea tu contraseña</h1>
    <p class="subtitle">Estás configurando el acceso para <strong><%= email %></strong>. Elige una contraseña que solo tú conozcas.</p>

    <form method="POST" action="/invite/<%= token %>">
      <label for="password">Nueva contraseña</label>
      <input type="password" id="password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres" autofocus />

      <label for="confirm">Confirma tu contraseña</label>
      <input type="password" id="confirm" name="confirm" required minlength="8" placeholder="Repite la contraseña" />

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <button type="submit">Crear contraseña y continuar</button>
    </form>

    <p class="hint">Después de esto te pediremos configurar la verificación en dos pasos.</p>
  </div>
</body>
</html>
